<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared chrome copy for :core:ui (LLM.md §4: "Shared chrome copy goes in :core:ui/src/main/res/").
  A string a single screen renders belongs to that feature module's own res/ instead.

  WORDING BAN (LLM.md §1, §5, STATE.md:42-44) — absolute, and a CI grep over
  **/src/**/res/values*/strings.xml enforces it. Nothing below claims to remove a virus, block a
  scam, speed up a phone or free RAM, and no string carries a performance percentage. The security
  feature is described by the owner's replacement framing, "app safety check" (STATE.md:48).
-->
<resources>

    <!-- ── shared actions and chrome ─────────────────────────────────────────────────────────── -->
    <string name="action_back">Back</string>
    <string name="action_delete">Delete</string>
    <string name="action_cancel">Cancel</string>
    <string name="action_retry">Try again</string>
    <string name="action_select_all">Select all</string>
    <string name="action_clear_selection">Clear selection</string>
    <string name="action_sort">Sort</string>
    <string name="state_loading">Working…</string>

    <!-- SelectionBar. A count with a plural body, never a hand-appended "s" — the competitor
         appends an English plural at java/nc/n0.java:62 (docs/screens/21 §3.2). -->
    <plurals name="selection_count">
        <item quantity="one">%1$d item selected</item>
        <item quantity="other">%1$d items selected</item>
    </plurals>

    <!-- ── AppError -> copy. Resolved at render time by error/ErrorMessages.kt so one error reads
         correctly in every locale (LLM.md §4, MVI §5). ─────────────────────────────────────── -->
    <string name="error_permission_denied">This needs a permission that has not been granted.</string>
    <string name="error_no_network">No connection right now.</string>
    <string name="error_not_found">That is no longer here.</string>
    <string name="error_storage">Storage could not be read.</string>
    <string name="error_unexpected">Something went wrong.</string>

    <!-- ── PIN pad content descriptions. The keypad holds no PIN; these name keys, not digits
         entered (docs/screens/21 §4.4). ────────────────────────────────────────────────────── -->
    <string name="pin_backspace">Delete last digit</string>
    <string name="pin_dots_state">%1$d of %2$d digits entered</string>

    <!-- ── the exit-dialog call to action. Four values, replacing the competitor's four-way `if`
         (docs/screens/21 §5.2). ────────────────────────────────────────────────────────────── -->
    <string name="feature_cta_clean">Clean now</string>
    <string name="feature_cta_review">Review now</string>
    <string name="feature_cta_check">Check now</string>
    <string name="feature_cta_open">Open</string>

