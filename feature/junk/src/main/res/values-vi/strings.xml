<?xml version="1.0" encoding="utf-8"?>
<!--
  Vietnamese (vi) for :feature:junk. Mirrors values/strings.xml key for key.

  WORDING BAN (LLM.md §1, §5) carries into every locale: no performance, security or memory claim and
  no percentage figure. The feature reports BYTES RECOVERED, measured, and says what it did not do.

  junk_review_empty stays a statement about the SCAN — "không tìm thấy tệp rác nào" — never a
  compliment about the device.

  PLURALS — Vietnamese has one CLDR category, `other`; a `one` body would never be selected.
-->
<resources>

    <string name="junk_title">Tệp rác</string>

    <!-- ── junkscan ──────────────────────────────────────────────────────────────────────────── -->
    <string name="junk_scan_scanning">Đang tìm tệp rác…</string>
    <string name="junk_scan_finished">Đã quét xong</string>
    <string name="junk_scan_stop_title">Dừng quét?</string>
    <string name="junk_scan_stop_body">Lượt quét sẽ dừng lại và những gì tìm được từ đầu đến giờ sẽ không được giữ.</string>
    <string name="junk_scan_stop_confirm">Dừng</string>

    <string name="junk_permission_title">Cần quyền truy cập bộ nhớ</string>
    <string name="junk_permission_body">Để liệt kê những tệp có thể xóa khỏi thiết bị này, ứng dụng cần quyền đọc bộ nhớ. Ứng dụng chỉ đọc phần bạn cho phép, và không xóa bất cứ thứ gì cho tới khi bạn chọn.</string>
    <string name="junk_permission_body_all_files">Tệp rác nằm ngoài thư mục ảnh và video, nên Android hỏi quyền này ở một trang Cài đặt riêng. Hãy bật \"Cho phép quản lý tất cả tệp\", rồi quay lại. Ứng dụng chỉ đọc — không xóa bất cứ thứ gì cho tới khi bạn chọn.</string>
    <string name="junk_permission_grant">Cho phép truy cập</string>

