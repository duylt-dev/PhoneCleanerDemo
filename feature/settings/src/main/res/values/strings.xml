    <!-- ── permission centre ─────────────────────────────────────────────────────────────────── -->
    <string name="settings_permissions_title">Permissions</string>
    <string name="settings_permissions_all_granted">Every permission this app asks for has been granted.</string>
    <string name="settings_permissions_granted_section">Granted</string>
    <string name="settings_permissions_grant">Grant</string>
    <string name="settings_permissions_open_settings">Open Settings</string>
    <string name="settings_permissions_declined">You returned without granting this. It can still be turned on in Settings.</string>
