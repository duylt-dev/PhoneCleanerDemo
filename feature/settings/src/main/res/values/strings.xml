    <string name="settings_language_fr_fr" translatable="false">Français</string>
    <string name="settings_language_de_de" translatable="false">Deutsch</string>
    <string name="settings_language_th_th" translatable="false">ไทย</string>
    <string name="settings_language_id_id" translatable="false">Bahasa Indonesia</string>
    <string name="settings_language_ms_my" translatable="false">Melayu</string>
    <string name="settings_language_vi_vn" translatable="false">Tiếng Việt</string>
    <string name="settings_language_ja_jp" translatable="false">日本語</string>
    <string name="settings_language_it_it" translatable="false">Italiano</string>
    <string name="settings_language_ko_kr" translatable="false">한국어</string>
    <string name="settings_language_nl_nl" translatable="false">Nederlands</string>
    <string name="settings_language_zh_hant_tw" translatable="false">繁體中文</string>
    <string name="settings_language_tr_tr" translatable="false">Türkçe</string>
