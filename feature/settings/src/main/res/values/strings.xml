    <string name="settings_permission_storage_title">Files and media</string>
    <string name="settings_permission_storage_body">Used to list the files on this device so you can review and delete them yourself. Nothing is uploaded.</string>
    <string name="settings_permission_media_title">Photos and videos</string>
    <string name="settings_permission_media_body">Used to read photos and videos for the photo tools. Nothing is uploaded.</string>
