    <!-- ── about ─────────────────────────────────────────────────────────────────────────────── -->
    <string name="settings_about_title">About</string>
    <!-- Version name, then build number in brackets. Both come from the installed package. -->
    <string name="settings_about_version">Version %1$s (%2$d)</string>
    <string name="settings_about_terms_of_service">Terms of Service</string>
    <string name="settings_about_privacy_policy">Privacy Policy</string>
    <string name="settings_about_developer_tools">Developer tools</string>

    <!-- ── webview ───────────────────────────────────────────────────────────────────────────── -->
    <string name="settings_webview_terms_title">Terms of Service</string>
    <string name="settings_webview_privacy_title">Privacy Policy</string>
