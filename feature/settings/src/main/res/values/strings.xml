<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy for :feature:settings. Shared chrome copy — Back, Retry, Cancel and the AppError messages —
  stays in :core:ui and is referenced from there.

  WORDING BAN (LLM.md §1, §5), enforced by a CI grep over **/src/**/res/values*/strings.xml: no
  marketing claim, and NO PERFORMANCE PERCENTAGE FIGURES. Nothing on these six screens reports a
  measurement at all, so every string below either names a destination or explains what a permission
  is used for. The banned wording is listed in LLM.md §5 and deliberately not repeated here, so this
  comment cannot itself trip the grep.

  Two groups are worth naming:

    * settings_language_* — the seventeen endonyms are translatable="false" ON PURPOSE. An endonym
      is the language's name IN THAT LANGUAGE; translating it defeats the only job it has, which is
      to be readable by someone who cannot read the current UI language.
    * settings_permission_* — the rationale copy. It states what the app does with the grant and
      never that the user's device is at risk without it.
-->
<resources>

    <!-- ── settings ──────────────────────────────────────────────────────────────────────────── -->
    <string name="settings_title">Settings</string>
    <string name="settings_row_language">Language</string>
    <string name="settings_row_permission_centre">Permissions</string>
    <string name="settings_trash_title">Trash</string>
    <string name="settings_trash_subtitle_empty">Empty</string>
    <!-- "3 items · 12.4 MB" — the size half is formatted by rememberByteFormat(), never here.
         A plural of our own: :feature:settings cannot see :feature:trash's own R.plurals. -->
    <plurals name="settings_trash_subtitle_count">
        <item quantity="one">%1$d item</item>
        <item quantity="other">%1$d items</item>
    </plurals>
    <string name="settings_row_about">About</string>
    <string name="settings_row_resident_widget">Show a shortcut in the status bar</string>
    <string name="settings_row_resident_widget_supporting">Off by default. You can turn this off again at any time.</string>
    <string name="settings_language_follow_system">System default</string>

    <!-- ── language ──────────────────────────────────────────────────────────────────────────── -->
    <string name="settings_language_title">Language</string>
    <string name="settings_language_save">Save</string>
    <string name="settings_language_system_default">System default</string>

    <!--
      The seventeen endonyms. translatable="false": see the header comment.
      Source and the three corrections against it: SupportedLanguages.kt in :data.
    -->
