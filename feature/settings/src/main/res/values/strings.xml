    <string name="settings_permission_notifications_body">Used to tell you when a task you started has finished.</string>
    <string name="settings_permission_listener_title">Notification access</string>
    <string name="settings_permission_listener_body">Needed by the notification cleaner to read and tidy the notifications already on this device. It is granted in a system screen.</string>

    <!--
      The steps a user follows in the system screen, shown BEFORE they leave. The competitor draws a
      translucent activity over the system Settings app 1 500 ms after handing the user out; that is
      a background activity start over another app, restricted since Android 10 (§5.4 delta 4).
    -->
    <string name="settings_permission_steps_title">In the screen that opens</string>
    <string name="settings_permission_steps_listener">1. Find this app in the list.\n2. Turn its switch on.\n3. Press back to return here.</string>

    <!-- ── developer tools (debug builds only) ───────────────────────────────────────────────── -->
    <string name="settings_devtools_title">Developer tools</string>
    <string name="settings_devtools_push_header">Simulate a push message</string>
    <string name="settings_devtools_push_hint">One key=value pair per line</string>
    <string name="settings_devtools_push_send">Deliver</string>
    <string name="settings_devtools_push_delivered">Delivered %1$d data key(s) to PushRepository</string>
    <string name="settings_devtools_push_invalid">No key=value pairs were recognised</string>
    <string name="settings_devtools_push_failed">PushRepository reported a failure</string>

</resources>
