    <string name="speed_test_abandon_confirm">Dừng</string>
    <string name="speed_test_abandon_dismiss">Tiếp tục đo</string>

    <!-- ── speedtestresult ───────────────────────────────────────────────────────────────────── -->
    <string name="speed_result_download">Tải xuống</string>
    <string name="speed_result_upload">Tải lên</string>
