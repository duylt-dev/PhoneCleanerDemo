    <string name="battery_health_unknown">Not reported</string>

    <string name="battery_technology_li_ion">Li-ion</string>
    <string name="battery_technology_li_poly">Li-poly</string>
    <string name="battery_technology_nimh">NiMH</string>
    <string name="battery_technology_nicd">NiCd</string>

    <!-- ── runningappsscan ──────────────────────────────────────────────────────────────────── -->
    <string name="running_apps_scan_title">Checking apps</string>
    <string name="running_apps_scan_caption">Listing the apps you can stop…</string>

    <!-- ──  runningapps ─────────────────────────────────────────────────────────────────────── -->
    <!--
      Named for what the list can deliver. The competitor calls it "Running Apps" and shows installed
      packages; the name is a claim its data does not support (docs/screens/18 §6.4).
    -->
    <string name="running_apps_title">Apps you can stop</string>
    <string name="running_apps_section">Apps you can stop</string>
    <string name="running_apps_memory_label">Device memory</string>
    <string name="running_apps_stop">Stop</string>
    <string name="running_apps_stopped">Stopped</string>
    <string name="running_apps_skip">Done</string>
    <string name="running_apps_empty">There are no third-party apps here that Android will let this app hand to Settings.</string>

    <!-- The instruction sheet, shown BEFORE the trip to Settings (§7). -->
    <string name="running_apps_instructions_title">Stopping an app</string>
    <string name="running_apps_instructions_body">Android only lets you stop an app from its own Settings page. This opens that page — tap <b>Force stop</b> there, then come back.</string>
    <string name="running_apps_instructions_note">This app cannot stop another app itself, and it will only mark one as stopped if Android reports it that way when you return.</string>
    <string name="running_apps_instructions_open">Open settings</string>
    <string name="running_apps_instructions_cancel">Not now</string>
    <string name="running_apps_instructions_illustration">An illustration of the Force stop button on the system app page</string>

    <!--
      PENDING OWNER DECISION 3 — docs/screens/18 §0.1 / system-architecture §10.1 P1, UNSETTLED.
      This copy describes what the list IS and what usage access WOULD add. It does not claim this
      screen reads usage statistics, because it does not — the permission is declared for App
      Manager's Last used column, and nothing in this cluster reads a usage statistic.
    -->
    <string name="running_apps_usage_access_title">This list shows installed apps</string>
    <string name="running_apps_usage_access_body">Android does not let an app see which apps are running without usage access. Without it, this list is the third-party apps on this device that Android reports as not already stopped.</string>
    <string name="running_apps_usage_access_grant">Open usage access settings</string>
    <string name="running_apps_usage_access_dismiss">Continue without it</string>

</resources>
